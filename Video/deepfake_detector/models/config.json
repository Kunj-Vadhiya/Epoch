{
  "project": "Is That Really Them? - Deepfake Scam Ad Detector",
  "version": "1.0.0",
  "architecture": "EfficientNet-B0 + Bidirectional GRU",
  "input_shape": [16, 3, 224, 224],
  "visual_backbone": "efficientnet_b0",
  "visual_feature_dim": 1280,
  "temporal_model": "GRU",
  "temporal_hidden_size": 256,
  "temporal_num_layers": 2,
  "temporal_bidirectional": true,
  "num_classes": 2,
  "class_mapping": {
    "0": "REAL",
    "1": "FAKE"
  },
  "uncertainty_threshold": 0.60,
  "face_tracking": "IoU temporal trajectory smoothing",
  "dataset": "FaceForensics++ C23",
  "fast_mode": {
    "total": 800,
    "train": 640,
    "val": 80,
    "test": 80
  },
  "normal_mode": {
    "total": 1000,
    "train": 800,
    "val": 100,
    "test": 100
  },
  "saved_model_path": "models/deepfake_efficientnet_b0_best.pth",
  "fusion_model_path": "models/fusion_model.pkl"
}
